# 建行学习刷课系统配置示例
# 复制为 .env 并填写真实值；.env 不要提交到 git
# 账号密码建议从保险库注入，勿写死、勿发聊天

CCB_USERNAME=你的账号.ln
CCB_PASSWORD=你的密码

# Web 服务端口
WEB_PORT=8090

# 刷课参数
# 单次心跳跨度（秒），模仿真人，建议 30-60
HEARTBEAT_MIN=30
HEARTBEAT_MAX=60
# 同时刷的视频并发数，0=无限制（速度快但风控风险高）；保守建议 2-3
CONCURRENCY=0
# 是否启用随机抖动
JITTER=true

# 登录 token 刷新策略
TOKEN_REFRESH_ON_401=true
